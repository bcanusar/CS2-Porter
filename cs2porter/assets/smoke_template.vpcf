<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:vpcf66:version{dd571be4-586e-4f41-8b2d-5bbc969e1c53} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	m_nMaxParticles = $max_particles
	m_flMaxDrawDistance = 6000.0
	m_flConstantRadius = $radius_max
	m_controlPointConfigurations =
	[
		{
			m_name = "preview"
			m_drivers =
			[
				{
					m_iAttachType = "PATTACH_WORLDORIGIN"
					m_entityName = "self"
				},
				{
					m_iControlPoint = 1
					m_iAttachType = "PATTACH_WORLDORIGIN"
					m_vecOffset = [ 256.0, 256.0, 128.0 ]
					m_entityName = "self"
				},
			]
		},
	]
	m_Emitters =
	[
$emitter
	]
	m_Initializers =
	[
$position
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = $life_min
				m_flRandomMax = $life_max
			}
			m_nOutputField = 1
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = $radius_min
				m_flRandomMax = $radius_max
			}
			m_nOutputField = 3
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.0
				m_flRandomMax = 360.0
			}
			m_nOutputField = 4
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = -$spin
				m_flRandomMax = $spin
			}
			m_nOutputField = 5
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $alpha
			}
			m_nOutputField = 7
		},
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ $color_min ]
			m_ColorMax = [ $color_max ]
		},
		{
			_class = "C_INIT_RandomSequence"
			m_nSequenceMax = 1
		},
		{
			_class = "C_INIT_RandomYawFlip"
		},
		{
			_class = "C_INIT_VelocityRandom"
			m_LocalCoordinateSystemSpeedMin =
			{
				m_nType = "PVEC_TYPE_LITERAL"
				m_vLiteralValue = [ $dir_min ]
			}
			m_LocalCoordinateSystemSpeedMax =
			{
				m_nType = "PVEC_TYPE_LITERAL"
				m_vLiteralValue = [ $dir_max ]
			}
			m_fSpeedMin =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $speed_min
			}
			m_fSpeedMax =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $speed_max
			}
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_BasicMovement"
			m_fDrag = $drag
		},
		{
			_class = "C_OP_SpinUpdate"
		},
		{
			_class = "C_OP_InterpolateRadius"
			m_flStartScale = 1.0
			m_flEndScale = $end_scale
		},
$operators
	]
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_flAnimationRate = 0.8
			m_vecTexturesInput =
			[
				{
					m_hTexture = resource:"materials/particle/vistasmokev1/vistasmokev1_emods.vtex"
					m_nTextureChannels = "SPRITECARD_TEXTURE_CHANNEL_MIX_A"
				},
			]
			m_flSelfIllumAmount =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $self_illum
			}
			m_nFeatheringMode = "PARTICLE_DEPTH_FEATHERING_ON_OPTIONAL"
		},
	]
}
