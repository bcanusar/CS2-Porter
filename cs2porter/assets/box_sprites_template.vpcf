					m_vecOffset = [ 256.0, 256.0, 128.0 ]
					m_entityName = "self"
				},
				{
					m_iControlPoint = 2
					m_iAttachType = "PATTACH_WORLDORIGIN"
					m_vecOffset = [ 255.0, 160.0, 80.0 ]
					m_entityName = "self"
				},
			]
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			m_flEmitRate =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $rate
			}
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinBox"
			m_bLocalSpace = false
			m_vecMin =
			{
				m_nType = "PVEC_TYPE_FLOAT_COMPONENTS"
				m_FloatComponentX =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 0
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = -0.5
				}
				m_FloatComponentY =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 1
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = -0.5
				}
				m_FloatComponentZ =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 2
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = -0.5
				}
			}
			m_vecMax =
			{
				m_nType = "PVEC_TYPE_FLOAT_COMPONENTS"
				m_FloatComponentX =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 0
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = 0.5
				}
				m_FloatComponentY =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 1
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = 0.5
				}
				m_FloatComponentZ =
				{
					m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
					m_nControlPoint = 1
					m_nVectorComponent = 2
					m_nMapType = "PF_MAP_TYPE_MULT"
					m_flMultFactor = 0.5
				}
			}
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = $life_min
				m_flRandomMax = $life_max
			}
			m_nOutputField = 1
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = $radius_min
				m_flRandomMax = $radius_max
			}
			m_nOutputField = 3
		},
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = $alpha
			}
			m_nOutputField = 7
		},
		{
			_class = "C_INIT_VelocityRandom"
			m_LocalCoordinateSystemSpeedMin =
			{
				m_nType = "PVEC_TYPE_LITERAL"
				m_vLiteralValue = [ $vel_min ]
			}
			m_LocalCoordinateSystemSpeedMax =
			{
				m_nType = "PVEC_TYPE_LITERAL"
				m_vLiteralValue = [ $vel_max ]
			}
		},
	]
