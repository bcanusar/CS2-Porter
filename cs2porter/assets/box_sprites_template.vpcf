			m_flStartScale = 1.0
			m_flEndScale = $end_scale
		},
		{
			_class = "C_OP_FadeIn"
			m_flFadeInTimeMin = $fade_in
			m_flFadeInTimeMax = $fade_in
			m_bProportional = true
		},
		{
			_class = "C_OP_FadeOut"
			m_flFadeOutTimeMin = $fade_out
			m_flFadeOutTimeMax = $fade_out
			m_bProportional = true
		},
		{
			_class = "C_OP_RemapCPtoVector"
			m_nCPInput = 2
			m_nFieldOutput = 6
			m_vInputMax = [ 255.0, 255.0, 255.0 ]
			m_vOutputMax = [ 1.0, 1.0, 1.0 ]
